{
  "name": "moodle-core-cli",
  "version": "0.3.6",
  "description": "Friendly Node.js client and CLI for Moodle 4.5+ core web services.",
  "type": "module",
  "license": "MIT",
  "author": "Pablo Gallego",
  "homepage": "https://moodlia.com/products/moodle-core-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gafapa/moodle-core-cli.git"
  },
  "bugs": {
    "url": "https://github.com/gafapa/moodle-core-cli/issues"
  },
  "main": "./client/moodle-rest-client.mjs",
  "types": "./client/moodle-rest-client.d.ts",
  "sideEffects": false,
  "bin": {
    "moodle-core": "cli/moodle-core.mjs"
  },
  "exports": {
    ".": {
      "types": "./client/moodle-rest-client.d.ts",
      "import": "./client/moodle-rest-client.mjs"
    },
    "./transport": {
      "types": "./client/transport-kernel.d.ts",
      "import": "./client/transport-kernel.mjs"
    },
    "./canonical": {
      "types": "./canonical/index.d.ts",
      "import": "./canonical/index.mjs"
    },
    "./contract": "./contract/operations.json",
    "./capabilities": {
      "types": "./capabilities/registry.d.ts",
      "import": "./capabilities/registry.mjs"
    },
    "./profiles": {
      "types": "./profiles/profiles.d.ts",
      "import": "./profiles/profiles.mjs"
    },
    "./sync": {
      "types": "./sync/index.d.ts",
      "import": "./sync/index.mjs"
    },
    "./workflows": {
      "types": "./workflows/index.d.ts",
      "import": "./workflows/index.mjs"
    },
    "./exit-codes": {
      "types": "./cli/exit-codes.d.ts",
      "import": "./cli/exit-codes.mjs"
    },
    "./cli-runner": {
      "types": "./cli/runner.d.ts",
      "import": "./cli/moodle-core.mjs"
    },
    "./adapters/core": {
      "types": "./adapters/core/index.d.ts",
      "import": "./adapters/core/index.mjs"
    }
  },
  "files": [
    "cli/",
    "client/",
    "canonical/",
    "capabilities/",
    "profiles/",
    "sync/",
    "workflows/",
    "adapters/",
    "contract/operations.json",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "types:generate": "node tools/generate-operation-types.mjs",
    "types:check": "node tools/generate-operation-types.mjs --check",
    "types:compile": "tsc --noEmit --skipLibCheck false --moduleResolution nodenext --module nodenext --target es2022 client/moodle-rest-client.d.ts tests/types-smoke.ts",
    "types:extract": "node tools/extract-moodle-response-types.mjs",
    "contract:check": "node tools/check-contract.mjs",
    "coverage:audit": "node tools/audit-moodle-source.mjs",
    "check": "npm run contract:check && npm run types:check && npm run types:compile && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "moodle",
    "cli",
    "rest",
    "client",
    "automation",
    "llm"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "php-parser": "^3.7.0",
    "typescript": "^7.0.2"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "parse5": "^8.0.1"
  }
}
